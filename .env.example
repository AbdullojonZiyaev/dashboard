# Backend WebSocket for live data. Leave empty to use the built-in simulator.
VITE_WS_URL=

# The chatbot reads ANTHROPIC_API_KEY from the environment of the dev/preview server
# (not from this file, and never in the browser). Example:
#   export ANTHROPIC_API_KEY=sk-ant-...

# Backend API for the Sensor readings page. In dev, /backend is forwarded to
# BACKEND_URL (default http://127.0.0.1:8000, see vite.config.js). Set VITE_BACKEND_URL
# only to call the API directly from the browser (then add this site to CORS_ORIGINS).
VITE_BACKEND_URL=
